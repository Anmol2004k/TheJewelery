{
  "auth": {
    "providers": [
      "google.com"
    ],
    "customClaims": {}
  },
  "firestore": {
    "collections": [
      {
        "name": "users",
        "documentId": "userId",
        "schema": {
          "email": "string",
          "displayName": "string",
          "photoURL": "string",
          "createdAt": "timestamp"
        },
        "securityRules": [
          {
            "operations": [
              "read",
              "write"
            ],
            "condition": "request.auth != null && request.auth.uid == userId"
          }
        ],
        "indexes": []
      },
      {
        "name": "orders",
        "documentId": "auto",
        "schema": {
          "userId": "string",
          "orderId": "string",
          "amount": "number",
          "currency": "string",
          "email": "string",
          "phone": "string",
          "firstName": "string",
          "lastName": "string",
          "address": "string",
          "city": "string",
          "state": "string",
          "pincode": "string",
          "country": "string",
          "items": "map",
          "status": "string",
          "createdAt": "timestamp"
        },
        "securityRules": [
          {
            "operations": [
              "read"
            ],
            "condition": "request.auth != null && request.auth.uid == resource.data.userId"
          },
          {
            "operations": [
              "create"
            ],
            "condition": "request.auth != null && request.auth.uid == request.resource.data.userId"
          }
        ],
        "indexes": [
          {
            "fields": [
              "userId",
              "createdAt"
            ],
            "orders": [
              "ASC",
              "DESC"
            ]
          }
        ]
      },
      {
        "name": "contact_messages",
        "documentId": "auto",
        "schema": {
          "firstName": "string",
          "lastName": "string",
          "fullName": "string",
          "email": "string",
          "subject": "string",
          "message": "string",
          "status": "string",
          "userId": "string",
          "createdAt": "timestamp"
        },
        "securityRules": [
          {
            "operations": [
              "create"
            ],
            "condition": "true"
          },
          {
            "operations": [
              "read",
              "update",
              "delete"
            ],
            "condition": "isAdmin()"
          }
        ],
        "indexes": [
          {
            "fields": [
              "createdAt"
            ],
            "orders": [
              "DESC"
            ]
          }
        ]
      }
    ]
  }
}
